{
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 2,
		"patch": 0
	},
	"version": 10,
	"configurePresets": [
		{
			"name": "base",
			"binaryDir": "${sourceDir}/Builds/${presetName}",
			"warnings": {
				"deprecated": true,
				"dev": true,
				"uninitialized": false,
				"unusedCli": false
			},
			"hidden": true
		}
	],
	"buildPresets": [
		{
			"name": "base",
			"cleanFirst": false,
			"configuration": "Debug",
			"hidden": true,
			"verbose": false
		}
	]
}